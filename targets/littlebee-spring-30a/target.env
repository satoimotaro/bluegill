# BlueGill target: LittleBee Spring 30A (SiLabs EFM8BB21)
# Sourced by tools/build/build.sh. Shell KEY=VALUE, no spaces around '='.

# --- MCU ------------------------------------------------------------------
# EFM8BB21, bootloader signature E8 B2 (confirmed by pico-esc-tool esc_flash).
# Keil symbol MCU_TYPE=1. Letter H appears in the layout tag (#<L>_H_<DT>#).
MCU=H

# --- PWM frequency --------------------------------------------------------
# Compile-time choice (NOT an EEPROM param): which hex you flash sets it.
# Default 24 kHz — low-KV / high-inductance thruster motors don't need 96 kHz,
# and 24 kHz gives the most duty resolution per PWM period at the tiny duties
# low-speed running needs. ALSO build a 48 kHz variant for A/B on the bench:
#   ./tools/build/build.sh -p 48   (or set PWM=48 here)
PWM=24

# --- LAYOUT (FET/pin map letter) — PLACEHOLDER, READ OFF HARDWARE ----------
# The layout letter selects the pin/FET map AND is baked into the 0x1A40 tag
# (#<LAYOUT>_<MCU>_<DEADTIME>#). pico-esc-tool's compat guard does a byte-exact
# strcmp of the ESC's stored 0x1A40 tag vs the firmware's tag, so a wrong letter
# blocks the un-forced flash. DO NOT GUESS. Determine it per README.md:
#   python host/esctool.py list   ->  the printed layout tag gives L/MCU/deadtime.
# LAYOUT=?   (leave unset until read; build.sh errors out rather than guess)

# --- DEADTIME (ns-class integer) — PLACEHOLDER, READ OFF HARDWARE ---------
# Also baked into the 0x1A40 tag, so it must equal the value the stock firmware
# uses for the guard to pass un-forced. Valid upstream set:
#   0 5 10 15 20 25 30 40 50 70 90 120
# Read it from the stock layout tag (README.md) — do not guess.
# DEADTIME=?

# --- Version string (hex filename suffix) ---------------------------------
# Leave unset to inherit the pinned vendor tag (v0.21.0) so names match the
# official release scheme; set once BlueGill overlays exist, e.g. bluegill-v0.1.0.
# VERSION=

# --- Motor facts (fill from the actual thruster — needed for eRPM math) ----
# eRPM = mechanical_RPM * (pole_count / 2). Record the real motor here.
# MOTOR_POLES=            # magnet pole count (e.g. 14 -> 7 pole-pairs)
# MOTOR_KV=               # KV rating (rpm/V), if known
